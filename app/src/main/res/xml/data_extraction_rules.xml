<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="super_fast_scan.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="scans/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="super_fast_scan.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="scans/" />
    </device-transfer>
</data-extraction-rules>
